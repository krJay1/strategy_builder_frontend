# ==============================================================================
# First Demat - Strategy Builder Frontend Environment Configuration (.env.example)
# ==============================================================================

# Backend API Base URL
# Leave empty in local development to use Vite proxy (/api -> http://localhost:8091)
# In Production: e.g. https://api.firstdemat.in
VITE_API_URL=

# Symphony Master / Interactive API URL (for instrument subscription & master metadata)
# Default: https://uat.firstdemat.in
VITE_SYMPHONY_API_URL=https://uat.firstdemat.in

# Real-time Market Data WebSocket URL (socket-service)
# Leave empty in local development to use Vite proxy (/ws -> ws://localhost:8081)
# In Production: e.g. wss://socket.firstdemat.in/ws
VITE_MARKET_WS_URL=

# Real-time Strategy MTM Calculation WebSocket URL (strategy-builder)
# Leave empty in local development to use Vite proxy (/ws/strategy -> ws://localhost:8091)
# In Production: e.g. wss://api.firstdemat.in/ws/strategy
VITE_STRATEGY_WS_URL=

# Default Authentication & Session Credentials (pre-fills terminal credentials)
VITE_DEFAULT_USER_ID=AA002
VITE_DEFAULT_CLIENT_ID=AA002
VITE_DEFAULT_TOKEN=

# Default Initial Underlying Asset Configuration
VITE_DEFAULT_UNDERLYING_SEGMENT=1
VITE_DEFAULT_UNDERLYING_ID=2885
VITE_DEFAULT_UNDERLYING_SPOT=1309.1
